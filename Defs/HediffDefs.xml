
<Defs>
    <HediffDef>
        <defName>Sunshower_Sinking</defName>
        <label>Sinking mind</label>
        <description>Gloom...</description>
        <initialSeverity>0.1</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <isBad>true</isBad>
        <hediffClass>hediffWithComps</hediffClass>
        <defaultLabelColor>(45, 124, 229)</defaultLabelColor>
        <alwaysShowSeverity>true</alwaysShowSeverity>
        <stages>
            <li>
                <label>Minor</label>
                <minSeverity>0.0</minSeverity>
            </li>
            <li>
                <label>Mild</label>
                <minSeverity>0.2</minSeverity>
            </li>
            <li>
                <label>Serious</label>
                <minSeverity>0.4</minSeverity>
            </li>
            <li>
                <label>Extreme</label>
                <minSeverity>0.6</minSeverity>
            </li>
            <li>
                <label>Panic</label>
                <minSeverity>0.8</minSeverity>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.2</severityPerDay>
                <showHoursToRecover>false</showHoursToRecover>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>Sunshower_BreakProtection</defName>
        <label>Sunshower raincoat</label>
        <description>Provides buffs based on pawn's sinking</description>
        <initialSeverity>0.1</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <hediffClass>Sunshower.SunshowerHediffClass</hediffClass>
        <defaultLabelColor>(120, 116, 116)</defaultLabelColor>
        <alwaysShowSeverity>false</alwaysShowSeverity>
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
            </li>
            <li>
                <minSeverity>0.2</minSeverity>
                <statFactors>
                    <IncomingDamageFactor>0.9</IncomingDamageFactor>
                    <MeleeCooldownFactor>0.9</MeleeCooldownFactor>
                    <MeleeDamageFactor>0.9</MeleeDamageFactor>
                </statFactors>
                <statOffsets>
                    <MoveSpeed>0.2</MoveSpeed>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.4</minSeverity>
                <statFactors>
                    <IncomingDamageFactor>0.7</IncomingDamageFactor>
                    <MeleeCooldownFactor>0.7</MeleeCooldownFactor>
                    <MeleeDamageFactor>0.7</MeleeDamageFactor>
                </statFactors>
                <statOffsets>
                    <MoveSpeed>0.5</MoveSpeed>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.6</minSeverity>
                <statFactors>
                    <IncomingDamageFactor>0.5</IncomingDamageFactor>
                    <MeleeCooldownFactor>0.5</MeleeCooldownFactor>
                    <MeleeDamageFactor>0.5</MeleeDamageFactor>
                </statFactors>
                <statOffsets>
                    <MoveSpeed>0.75</MoveSpeed>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.8</minSeverity>
                <statFactors>
                    <IncomingDamageFactor>0.3</IncomingDamageFactor>
                    <MeleeCooldownFactor>0.3</MeleeCooldownFactor>
                    <MeleeDamageFactor>0.3</MeleeDamageFactor>
                </statFactors>
                <statOffsets>
                    <MoveSpeed>1.0</MoveSpeed>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>Sunshower_BreakProtectionCooldown</defName>
        <label>Mental break protection (Cooldown)</label>
        <description>This pawn's mental break was intercepted and prevented.</description>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <hediffClass>hediffWithComps</hediffClass>
        <defaultLabelColor>(120, 116, 116)</defaultLabelColor>
        <alwaysShowSeverity>false</alwaysShowSeverity>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.5</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
        </comps>
    </HediffDef>
</Defs>
